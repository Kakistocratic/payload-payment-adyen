{
  "name": "payload-payment-adyen",
  "version": "0.1.0",
  "description": "Adyen payment adapter and checkout helpers for Payload Ecommerce.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-ecommerce",
    "adyen",
    "payments",
    "checkout"
  ],
  "homepage": "https://github.com/Kakistocratic/adyen-tester/tree/main/packages/payload-payment-adyen#readme",
  "bugs": {
    "url": "https://github.com/Kakistocratic/adyen-tester/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kakistocratic/adyen-tester.git",
    "directory": "packages/payload-payment-adyen"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "payload-payment-adyen": "./dist/bin/migrate-starter.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "pack:dry": "pnpm pack --dry-run",
    "prepare": "tsup"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./utilities": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "peerDependencies": {
    "@adyen/adyen-web": "^6.40.0",
    "@payloadcms/plugin-ecommerce": "^3.85.0",
    "next": "^15 || ^16",
    "payload": "^3.85.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
